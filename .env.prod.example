# Production environment variable names (NO secrets).
# Fill real values in Portainer / server env — never commit filled copies.
# Aligns with specs/keys.md + specs/deployment-plan.md
# Target: 野草云3 · kb.agent-mate.ai · stack kb-agent

# ── QWEN（百炼 / DashScope；公网兼容模式默认值，专属实例可覆盖）──
QWEN_API_KEY=
QWEN_HOST=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_NATIVE_BASE_URL=
QWEN_WORKSPACE=
QWEN_REGION=
QWEN_CHAT_MODEL=
QWEN_CHAT_MODEL_FALLBACK=
QWEN_VL_MODEL=
QWEN_IMAGE_MODEL=
QWEN_EMBED_MODEL=
EMBED_DIM=
QWEN_KEY_MGMT_SITE=https://bailian.console.aliyun.com/

# ── Resend ──────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_HOST=api.resend.com
RESEND_BASE_URL=https://api.resend.com
RESEND_KEY_MGMT_SITE=https://resend.com/api-keys
SMTP_URL=

# ── PostgreSQL（外部托管；库名 kb_agent；禁止 NEXT_PUBLIC_*）──
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=kb_agent
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/kb_agent

# ── Qdrant（compose 容器名 kb-qdrant；勿用 127.0.0.1）────────
QDRANT_URL=http://kb-qdrant:6333
QDRANT_COLLECTION=kb_chunks

# ── 服务发现（portainer_network 内网；浏览器不直连）──────────
# kb-web → agent
AGENT_BASE_URL=http://kb-agent:8000
# agent → rag
RAG_BASE_URL=http://kb-rag:8001
RAG_SERVICE_TOKEN=
# 公网基址（邀请链接、重置邮件、对外；域名须与 NPM/DNS 一致）
PUBLIC_BASE_URL=https://kb.agent-mate.ai
# 前端可见公网源（构建时注入）
NEXT_PUBLIC_APP_URL=https://kb.agent-mate.ai

BOOTSTRAP_ADMIN_EMAIL=me@ethanhuang.com
API_KEY_PEPPER=
SESSION_SECRET=

# ── 运行 / 镜像 ─────────────────────────────────────────────
BLOB_ROOT=/data/kb
USE_FAKE_EMBEDDER=false
IMAGE_TAG=latest

# ── 外部知识源（仅 kb-agent 服务端；客户端勿配，ADR-018）──
# 生产启用 kb_external_search 时必填 TAVILY_API_KEY；勿写入 IDE/ChatBox。
# EXA_API_KEY=
TAVILY_API_KEY=