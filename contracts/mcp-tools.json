{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kb.agent-mate.ai/contracts/mcp-tools.json",
  "title": "KbAgentMcpTools",
  "description": "MCP tool surface ↔ REST mapping. Drift checks for mcp-03/mcp-04 (MVP-2). See specs/mcp-design.md and specs/story-mapping.md module MCP.",
  "transport": {
    "primary": "streamable-http",
    "path": "/mcp",
    "legacy_sse": {
      "path": "/sse",
      "messages_path": "/messages/",
      "clients": ["ChatBox Remote (http/sse)"]
    },
    "auth": "Authorization: Bearer <api_key>"
  },
  "mvp": "MVP-2",
  "tools": [
    {
      "name": "kb_internal_search",
      "rest": { "method": "POST", "path": "/api/v1/kb/search" },
      "side_effect": "none",
      "required": true,
      "input": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "project": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "top_k": { "type": "integer", "minimum": 1, "maximum": 50 }
        },
        "additionalProperties": false
      },
      "output_ref": "search-response.schema.json",
      "forbidden_params": ["user_id"]
    },
    {
      "name": "kb_propose_add",
      "rest": { "method": "POST", "path": "/api/v1/kb/proposals" },
      "side_effect": "pending",
      "required": true,
      "input": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "project": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "forbidden_params": ["user_id", "skip_confirm", "auto_ingest"]
    },
    {
      "name": "kb_confirm_add",
      "rest": { "method": "POST", "path": "/api/v1/kb/proposals/{id}/confirm" },
      "side_effect": "write_index",
      "required": true,
      "input": {
        "type": "object",
        "required": ["pending_id"],
        "properties": {
          "pending_id": { "type": "string" }
        },
        "additionalProperties": false
      },
      "forbidden_params": ["user_id", "skip_confirm"]
    },
    {
      "name": "kb_list_knowledge",
      "rest": { "method": "GET", "path": "/api/v1/kb/items" },
      "side_effect": "none",
      "required": false,
      "note": "Optional in same MVP-2 batch; items include summary (<=400 chars overview)",
      "input": {
        "type": "object",
        "properties": {
          "project": { "type": "string" },
          "tag": { "type": "string" },
          "knowledge_type": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        },
        "additionalProperties": false
      },
      "forbidden_params": ["user_id"]
    },
    {
      "name": "kb_knowledge_summary",
      "rest": {
        "method": "GET|POST",
        "path": "/api/v1/kb/items/{id}/summary",
        "refresh": "POST /api/v1/kb/items/{id}/summary/refresh"
      },
      "side_effect": "metadata_write_on_refresh",
      "required": true,
      "note": "Content overview; max 400 Unicode chars. See specs/knowledge-summary.md",
      "input": {
        "type": "object",
        "properties": {
          "knowledge_id": { "type": "string" },
          "pending_id": { "type": "string" },
          "refresh": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      },
      "forbidden_params": ["user_id"]
    }
  ],
  "not_in_mvp2": [
    "kb_list",
    "kb_organize",
    "kb_external_search",
    "kb_fetch_url",
    "kb_import_documents",
    "kb_confirm_import_batch"
  ],
  "renamed_from": {
    "kb_internal_search": "kb_search",
    "kb_propose_add": "kb_propose_ingest",
    "kb_confirm_add": "kb_confirm_ingest",
    "kb_external_search": "kb_source_search",
    "kb_fetch_url": "kb_fetch"
  }
}
