# Local development defaults (copy to .env — gitignored). Aligns with specs/keys.md.
# Start stack: make up-daemon (preferred) | make down | make status
# If apps die under Cursor Agent: specs/knowledge/ops/local-apps-keep-dying.md

# ── QWEN（百炼 / MaaS；本地可留空，CI 用 Fake Embedder）────────
QWEN_API_KEY=
QWEN_HOST=
QWEN_BASE_URL=
QWEN_NATIVE_BASE_URL=
QWEN_WORKSPACE=
QWEN_REGION=
QWEN_CHAT_MODEL=
QWEN_CHAT_MODEL_FALLBACK=
QWEN_VL_MODEL=
QWEN_IMAGE_MODEL=
QWEN_EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
QWEN_KEY_MGMT_SITE=

# ── Email / Resend（MVP-3；本地可留空）────────────────────────────────
RESEND_API_KEY=
RESEND_HOST=api.resend.com
RESEND_BASE_URL=https://api.resend.com
RESEND_KEY_MGMT_SITE=https://resend.com/api-keys
SMTP_URL=

# ── PostgreSQL ────────────────────────────────────────────────────────
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_USER=kb
DATABASE_PASSWORD=kb_dev_password
DATABASE_NAME=kb_agent
DATABASE_URL=postgresql+psycopg://kb:kb_dev_password@127.0.0.1:5434/kb_agent

# ── Qdrant ────────────────────────────────────────────────────────────
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=kb_chunks
# MVP-2 Done / true-stack: QDRANT_COLLECTION=kb_chunks_v3 EMBED_DIM=1024 USE_FAKE_EMBEDDER=false USE_FAKE_KM=false

# ── Service discovery（环境变量；本地用 127.0.0.1，生产见 .env.prod.example）──
PUBLIC_BASE_URL=http://127.0.0.1:3000
AGENT_BASE_URL=http://127.0.0.1:8000
RAG_BASE_URL=http://127.0.0.1:8001
RAG_SERVICE_TOKEN=dev-rag-token
BOOTSTRAP_ADMIN_EMAIL=me@ethanhuang.com
API_KEY_PEPPER=dev-api-key-pepper-change-me
# Optional; if empty, local/dev may derive from API_KEY_PEPPER (ADR-007). Production: set explicitly.
API_KEY_ENCRYPTION_SECRET=
SESSION_SECRET=dev-session-secret-change-me-32chars

# ── Paths ─────────────────────────────────────────────────────────────
BLOB_ROOT=./data/blob
USE_FAKE_EMBEDDER=true
USE_FAKE_KM=true
# MVP-1 / CI 廉价车道可用 true。MVP-2 闭环交付门禁须 USE_FAKE_EMBEDDER=false USE_FAKE_KM=false + 真 DashScope（见 specs/mvp-2-3-delivery.md）。

# ── kb-web（浏览器可见；生产改为 https://kb.agent-mate.ai）────────────
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
